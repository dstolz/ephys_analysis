{
  "schema": "ephys-plot-design",
  "version": 1,
  "name": "Gray panel",
  "description": "The ggplot2 look: each plot on a gray panel ruled by a white grid, no axis box, ggplot's evenly spaced hues and its dark-to-light blue scale.",
  "background": "#ffffff",
  "palette": ["#F8766D", "#00BFC4", "#7CAE00", "#C77CFF", "#CD9600", "#00A9FF", "#00BE67", "#FF61CC"],
  "single": "#595959",
  "sequential": ["#132b43", "#28547a", "#3e81b7", "#56b1f7"],
  "heat": ["#132b43", "#1d3f5e", "#28547a", "#336a98", "#3e81b7", "#4a98d6", "#56b1f7"],
  "diverging": ["#2c7bb6", "#abd9e9", "#ffffbf", "#fdae61", "#d7191c"],
  "rules": [
    {"role": "plotTitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "plotTitle", "property": "FontWeight", "value": "normal"},
    {"role": "plotTitle", "property": "Color", "value": "#000000"},
    {"role": "plotSubtitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "plotSubtitle", "property": "Color", "value": "#4d4d4d"},

    {"role": "axes", "property": "Color", "value": "#ebebeb"},
    {"role": "axes", "property": "XColor", "value": "#4d4d4d"},
    {"role": "axes", "property": "YColor", "value": "#4d4d4d"},
    {"role": "axes", "property": "LineWidth", "value": 0.5},
    {"role": "axes", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "axes", "property": "TickDir", "value": "out"},
    {"role": "axes", "property": "TickLength", "value": [0.01, 0.02]},
    {"role": "axes", "property": "Box", "value": "off"},
    {"role": "axes", "property": "XGrid", "value": "on"},
    {"role": "axes", "property": "YGrid", "value": "on"},
    {"role": "axes", "property": "GridColor", "value": "#ffffff"},
    {"role": "axes", "property": "GridAlpha", "value": 1},
    {"role": "axes", "property": "GridLineStyle", "value": "-"},
    {"role": "rasterAxes", "property": "Color", "value": "#ebebeb"},
    {"role": "rasterAxes", "property": "XColor", "value": "#4d4d4d"},
    {"role": "rasterAxes", "property": "YColor", "value": "#4d4d4d"},
    {"role": "rasterAxes", "property": "LineWidth", "value": 0.5},
    {"role": "rasterAxes", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "rasterAxes", "property": "TickDir", "value": "out"},
    {"role": "rasterAxes", "property": "TickLength", "value": [0.01, 0.02]},
    {"role": "rasterAxes", "property": "Box", "value": "off"},
    {"role": "rasterAxes", "property": "XGrid", "value": "on"},
    {"role": "rasterAxes", "property": "YGrid", "value": "off"},
    {"role": "rasterAxes", "property": "GridColor", "value": "#ffffff"},
    {"role": "rasterAxes", "property": "GridAlpha", "value": 1},
    {"role": "rasterAxes", "property": "GridLineStyle", "value": "-"},

    {"role": "tileTitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "tileTitle", "property": "FontWeight", "value": "normal"},
    {"role": "tileTitle", "property": "Color", "value": "#1a1a1a"},
    {"role": "tileSubtitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "tileSubtitle", "property": "Color", "value": "#4d4d4d"},
    {"role": "xlabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "xlabel", "property": "Color", "value": "#000000"},
    {"role": "ylabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "ylabel", "property": "Color", "value": "#000000"},
    {"role": "ylabelRight", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "ylabelRight", "property": "Color", "value": "#000000"},
    {"role": "legend", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "legend", "property": "Color", "value": "#ffffff"},
    {"role": "legend", "property": "EdgeColor", "value": "#ebebeb"},
    {"role": "legend", "property": "TextColor", "value": "#000000"},
    {"role": "colorbar", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "colorbar", "property": "Box", "value": "off"},
    {"role": "colorbar", "property": "Color", "value": "#4d4d4d"},
    {"role": "colorbar", "property": "TickDirection", "value": "out"},

    {"role": "zeroLine", "property": "Color", "value": "#7f7f7f"},
    {"role": "zeroLine", "property": "LineStyle", "value": "--"},
    {"role": "zeroLine", "property": "LineWidth", "value": 0.75},
    {"role": "chanceLine", "property": "Color", "value": "#7f7f7f"},
    {"role": "chanceLine", "property": "LineStyle", "value": ":"},
    {"role": "stackBase", "property": "Color", "value": "#ffffff"},
    {"role": "modWindow", "property": "FaceColor", "value": "#ffffff"},
    {"role": "modWindow", "property": "FaceAlpha", "value": 0.5},
    {"role": "modWindow", "property": "Color", "value": "#1a1a1a"},
    {"role": "modMarks", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "rasterTicks", "property": "Color", "value": "#1a1a1a"},
    {"role": "rasterStop", "property": "Color", "value": "#F8766D"},
    {"role": "bar", "property": "EdgeColor", "value": "none"},
    {"role": "errorBar", "property": "Color", "value": "#333333"},
    {"role": "box", "property": "WhiskerLineColor", "value": "#333333"},
    {"role": "box", "property": "BoxFaceAlpha", "value": 0.4},
    {"role": "emptySites", "property": "Color", "value": "#bdbdbd"},
    {"role": "sites", "property": "MarkerEdgeColor", "value": "#ffffff"},
    {"role": "siteLabels", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "shankLabels", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "unitDots", "property": "Color", "value": "#1a1a1a"},
    {"role": "waveBox", "property": "EdgeColor", "value": "#bdbdbd"},
    {"role": "waveLabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "note", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "note", "property": "Color", "value": "#333333"}
  ],
  "kinds": {
    "heatmap": [
      {"role": "axes", "property": "XGrid", "value": "off"},
      {"role": "axes", "property": "YGrid", "value": "off"},
      {"role": "zeroLine", "property": "Color", "value": "#ffffff"}
    ],
    "corrmap": [
      {"role": "axes", "property": "XGrid", "value": "off"},
      {"role": "axes", "property": "YGrid", "value": "off"}
    ]
  }
}
