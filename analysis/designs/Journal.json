{
  "schema": "ephys-plot-design",
  "version": 1,
  "name": "Journal",
  "description": "Print-ready and colour-blind safe: Okabe-Ito group colours, viridis heat maps, Arial, black hairline axes with outward ticks, no box or grid.",
  "background": "#ffffff",
  "palette": ["#0072B2", "#D55E00", "#009E73", "#CC79A7", "#E69F00", "#56B4E9", "#F0E442", "#000000"],
  "single": "#000000",
  "sequential": ["#440154", "#3b528b", "#21918c", "#5ec962", "#b5de2b"],
  "heat": ["#440154", "#482878", "#3e4989", "#31688e", "#26828e", "#1f9e89", "#35b779", "#6ece58", "#b5de2b", "#fde725"],
  "diverging": ["#2166ac", "#67a9cf", "#d1e5f0", "#f7f7f7", "#fddbc7", "#ef8a62", "#b2182b"],
  "rules": [
    {"role": "plotTitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "plotTitle", "property": "FontWeight", "value": "bold"},
    {"role": "plotTitle", "property": "Color", "value": "#000000"},
    {"role": "plotSubtitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "plotSubtitle", "property": "Color", "value": "#4d4d4d"},

    {"role": "axes", "property": "Color", "value": "#ffffff"},
    {"role": "axes", "property": "XColor", "value": "#000000"},
    {"role": "axes", "property": "YColor", "value": "#000000"},
    {"role": "axes", "property": "LineWidth", "value": 0.5},
    {"role": "axes", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "axes", "property": "TickDir", "value": "out"},
    {"role": "axes", "property": "TickLength", "value": [0.015, 0.025]},
    {"role": "axes", "property": "Box", "value": "off"},
    {"role": "axes", "property": "XGrid", "value": "off"},
    {"role": "axes", "property": "YGrid", "value": "off"},
    {"role": "rasterAxes", "property": "Color", "value": "#ffffff"},
    {"role": "rasterAxes", "property": "XColor", "value": "#000000"},
    {"role": "rasterAxes", "property": "YColor", "value": "#000000"},
    {"role": "rasterAxes", "property": "LineWidth", "value": 0.5},
    {"role": "rasterAxes", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "rasterAxes", "property": "TickDir", "value": "out"},
    {"role": "rasterAxes", "property": "TickLength", "value": [0.015, 0.025]},
    {"role": "rasterAxes", "property": "Box", "value": "off"},
    {"role": "rasterAxes", "property": "XGrid", "value": "off"},
    {"role": "rasterAxes", "property": "YGrid", "value": "off"},

    {"role": "tileTitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "tileTitle", "property": "FontWeight", "value": "bold"},
    {"role": "tileTitle", "property": "Color", "value": "#000000"},
    {"role": "tileSubtitle", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "tileSubtitle", "property": "Color", "value": "#4d4d4d"},
    {"role": "xlabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "xlabel", "property": "Color", "value": "#000000"},
    {"role": "ylabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "ylabel", "property": "Color", "value": "#000000"},
    {"role": "ylabelRight", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "ylabelRight", "property": "Color", "value": "#000000"},
    {"role": "legend", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "legend", "property": "Color", "value": "#ffffff"},
    {"role": "legend", "property": "EdgeColor", "value": "#000000"},
    {"role": "legend", "property": "TextColor", "value": "#000000"},
    {"role": "colorbar", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "colorbar", "property": "Box", "value": "off"},
    {"role": "colorbar", "property": "LineWidth", "value": 0.5},
    {"role": "colorbar", "property": "Color", "value": "#000000"},
    {"role": "colorbar", "property": "TickDirection", "value": "out"},

    {"role": "zeroLine", "property": "Color", "value": "#000000"},
    {"role": "zeroLine", "property": "LineStyle", "value": "--"},
    {"role": "zeroLine", "property": "LineWidth", "value": 0.5},
    {"role": "chanceLine", "property": "Color", "value": "#7f7f7f"},
    {"role": "chanceLine", "property": "LineStyle", "value": ":"},
    {"role": "chanceLine", "property": "LineWidth", "value": 0.5},
    {"role": "stackBase", "property": "Color", "value": "#bfbfbf"},
    {"role": "modWindow", "property": "FaceColor", "value": "#000000"},
    {"role": "modWindow", "property": "FaceAlpha", "value": 0.06},
    {"role": "modWindow", "property": "Color", "value": "#000000"},
    {"role": "modMarks", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "rasterTicks", "property": "Color", "value": "#000000"},
    {"role": "rasterTicks", "property": "LineWidth", "value": 0.5},
    {"role": "rasterStop", "property": "Color", "value": "#D55E00"},
    {"role": "bar", "property": "EdgeColor", "value": "none"},
    {"role": "errorBar", "property": "Color", "value": "#000000"},
    {"role": "errorBar", "property": "LineWidth", "value": 0.5},
    {"role": "errorBar", "property": "CapSize", "value": 3},
    {"role": "box", "property": "LineWidth", "value": 0.5},
    {"role": "box", "property": "BoxFaceAlpha", "value": 0.3},
    {"role": "box", "property": "WhiskerLineColor", "value": "#000000"},
    {"role": "curve", "property": "MarkerSize", "value": 4},
    {"role": "curve", "property": "CapSize", "value": 2},
    {"role": "emptySites", "property": "Color", "value": "#bfbfbf"},
    {"role": "sites", "property": "MarkerEdgeColor", "value": "#4d4d4d"},
    {"role": "siteLabels", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "siteLabels", "property": "Color", "value": "#000000"},
    {"role": "shankLabels", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "shankLabels", "property": "FontWeight", "value": "bold"},
    {"role": "shankLabels", "property": "Color", "value": "#000000"},
    {"role": "unitDots", "property": "Color", "value": "#000000"},
    {"role": "waveBox", "property": "EdgeColor", "value": "#bfbfbf"},
    {"role": "waveMean", "property": "Color", "value": "#000000"},
    {"role": "waveLabel", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "waveLabel", "property": "Color", "value": "#4d4d4d"},
    {"role": "note", "property": "FontName", "value": "Arial, Helvetica"},
    {"role": "note", "property": "Color", "value": "#000000"}
  ],
  "kinds": {
    "heatmap": [
      {"role": "zeroLine", "property": "Color", "value": "#ffffff"}
    ],
    "corrmap": [
      {"role": "axes", "property": "Color", "value": "#d9d9d9"}
    ]
  }
}
