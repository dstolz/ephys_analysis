{
  "schema": "ephys-plot-design",
  "version": 1,
  "name": "Night",
  "description": "A dark slate ground for screens and dim rooms: soft Nord colors, light type, a faint grid when the plot shows one, inferno heat maps.",
  "background": "#1b1f27",
  "palette": ["#88c0d0", "#ebcb8b", "#bf616a", "#a3be8c", "#b48ead", "#d08770", "#81a1c1", "#8fbcbb"],
  "single": "#88c0d0",
  "sequential": ["#3b5a8a", "#5e81ac", "#81a1c1", "#88c0d0", "#cfe8ef"],
  "heat": ["#000004", "#1b0c41", "#4a0c6b", "#781c6d", "#a52c60", "#cf4446", "#ed6925", "#fb9b06", "#f7d13d", "#fcffa4"],
  "diverging": ["#5e9be0", "#36577e", "#262b35", "#7e3b3b", "#e06c5e"],
  "rules": [
    {"role": "plotTitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "plotTitle", "property": "FontWeight", "value": "bold"},
    {"role": "plotTitle", "property": "Color", "value": "#eceff4"},
    {"role": "plotSubtitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "plotSubtitle", "property": "Color", "value": "#9099a8"},

    {"role": "axes", "property": "Color", "value": "#1b1f27"},
    {"role": "axes", "property": "XColor", "value": "#9099a8"},
    {"role": "axes", "property": "YColor", "value": "#9099a8"},
    {"role": "axes", "property": "LineWidth", "value": 0.75},
    {"role": "axes", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "axes", "property": "TickDir", "value": "out"},
    {"role": "axes", "property": "Box", "value": "off"},
    {"role": "axes", "property": "GridColor", "value": "#4c566a"},
    {"role": "axes", "property": "GridAlpha", "value": 0.6},
    {"role": "axes", "property": "GridLineStyle", "value": "-"},
    {"role": "rasterAxes", "property": "Color", "value": "#1b1f27"},
    {"role": "rasterAxes", "property": "XColor", "value": "#9099a8"},
    {"role": "rasterAxes", "property": "YColor", "value": "#9099a8"},
    {"role": "rasterAxes", "property": "LineWidth", "value": 0.75},
    {"role": "rasterAxes", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "rasterAxes", "property": "TickDir", "value": "out"},
    {"role": "rasterAxes", "property": "Box", "value": "off"},
    {"role": "rasterAxes", "property": "GridColor", "value": "#4c566a"},
    {"role": "rasterAxes", "property": "GridAlpha", "value": 0.6},

    {"role": "tileTitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "tileTitle", "property": "Color", "value": "#d8dee9"},
    {"role": "tileSubtitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "tileSubtitle", "property": "Color", "value": "#9099a8"},
    {"role": "xlabel", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "xlabel", "property": "Color", "value": "#aab2c0"},
    {"role": "ylabel", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "ylabel", "property": "Color", "value": "#aab2c0"},
    {"role": "ylabelRight", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "ylabelRight", "property": "Color", "value": "#aab2c0"},
    {"role": "legend", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "legend", "property": "Color", "value": "#1b1f27"},
    {"role": "legend", "property": "EdgeColor", "value": "#4c566a"},
    {"role": "legend", "property": "TextColor", "value": "#d8dee9"},
    {"role": "colorbar", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "colorbar", "property": "Box", "value": "off"},
    {"role": "colorbar", "property": "Color", "value": "#9099a8"},
    {"role": "colorbar", "property": "TickDirection", "value": "out"},

    {"role": "zeroLine", "property": "Color", "value": "#6b7385"},
    {"role": "zeroLine", "property": "LineStyle", "value": ":"},
    {"role": "zeroLine", "property": "LineWidth", "value": 1},
    {"role": "chanceLine", "property": "Color", "value": "#6b7385"},
    {"role": "chanceLine", "property": "LineStyle", "value": "--"},
    {"role": "stackBase", "property": "Color", "value": "#3b4252"},
    {"role": "modWindow", "property": "FaceColor", "value": "#88c0d0"},
    {"role": "modWindow", "property": "FaceAlpha", "value": 0.08},
    {"role": "modWindow", "property": "Color", "value": "#d8dee9"},
    {"role": "modMarks", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "rasterTicks", "property": "Color", "value": "#d8dee9"},
    {"role": "rasterTicks", "property": "LineWidth", "value": 0.5},
    {"role": "rasterStop", "property": "Color", "value": "#bf616a"},
    {"role": "bar", "property": "EdgeColor", "value": "none"},
    {"role": "errorBar", "property": "Color", "value": "#d8dee9"},
    {"role": "box", "property": "BoxFaceAlpha", "value": 0.35},
    {"role": "box", "property": "WhiskerLineColor", "value": "#9099a8"},
    {"role": "swarm", "property": "MarkerFaceAlpha", "value": 0.75},
    {"role": "violin", "property": "FaceAlpha", "value": 0.35},
    {"role": "emptySites", "property": "Color", "value": "#4c566a"},
    {"role": "sites", "property": "MarkerEdgeColor", "value": "#2e3440"},
    {"role": "siteLabels", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "siteLabels", "property": "Color", "value": "#aab2c0"},
    {"role": "shankLabels", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "shankLabels", "property": "Color", "value": "#d8dee9"},
    {"role": "unitDots", "property": "Color", "value": "#eceff4"},
    {"role": "waveBox", "property": "EdgeColor", "value": "#4c566a"},
    {"role": "waveMean", "property": "Color", "value": "#ebcb8b"},
    {"role": "waveLabel", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "waveLabel", "property": "Color", "value": "#aab2c0"},
    {"role": "note", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "note", "property": "Color", "value": "#d8dee9"}
  ],
  "kinds": {
    "heatmap": [
      {"role": "zeroLine", "property": "Color", "value": "#ffffff"},
      {"role": "zeroLine", "property": "LineStyle", "value": "--"}
    ]
  }
}
