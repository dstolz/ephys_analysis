{
  "schema": "ephys-plot-design",
  "version": 1,
  "name": "Talk",
  "description": "For slides seen from the back of the room: big bold type, thick lines and marks, strong saturated colours, turbo heat maps.",
  "background": "#ffffff",
  "palette": ["#e41a1c", "#377eb8", "#4daf4a", "#984ea3", "#ff7f00", "#a65628", "#f781bf", "#999999"],
  "single": "#377eb8",
  "sequential": ["#0d0887", "#6a00a8", "#b12a90", "#e16462", "#fca636"],
  "heat": "turbo",
  "diverging": ["#2166ac", "#4393c3", "#f7f7f7", "#d6604d", "#b2182b"],
  "rules": [
    {"role": "plotTitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "plotTitle", "property": "FontSize", "value": 20},
    {"role": "plotTitle", "property": "FontWeight", "value": "bold"},
    {"role": "plotTitle", "property": "Color", "value": "#111111"},
    {"role": "plotSubtitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "plotSubtitle", "property": "FontSize", "value": 14},
    {"role": "plotSubtitle", "property": "Color", "value": "#555555"},

    {"role": "axes", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "axes", "property": "FontSize", "value": 14},
    {"role": "axes", "property": "LineWidth", "value": 1.5},
    {"role": "axes", "property": "XColor", "value": "#222222"},
    {"role": "axes", "property": "YColor", "value": "#222222"},
    {"role": "axes", "property": "TickDir", "value": "out"},
    {"role": "axes", "property": "TickLength", "value": [0.02, 0.03]},
    {"role": "axes", "property": "Box", "value": "off"},
    {"role": "axes", "property": "GridColor", "value": "#000000"},
    {"role": "axes", "property": "GridAlpha", "value": 0.12},
    {"role": "rasterAxes", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "rasterAxes", "property": "FontSize", "value": 14},
    {"role": "rasterAxes", "property": "LineWidth", "value": 1.5},
    {"role": "rasterAxes", "property": "XColor", "value": "#222222"},
    {"role": "rasterAxes", "property": "YColor", "value": "#222222"},
    {"role": "rasterAxes", "property": "TickDir", "value": "out"},
    {"role": "rasterAxes", "property": "TickLength", "value": [0.02, 0.03]},
    {"role": "rasterAxes", "property": "Box", "value": "off"},

    {"role": "tileTitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "tileTitle", "property": "FontSize", "value": 15},
    {"role": "tileTitle", "property": "FontWeight", "value": "bold"},
    {"role": "tileTitle", "property": "Color", "value": "#111111"},
    {"role": "tileSubtitle", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "tileSubtitle", "property": "FontSize", "value": 12},
    {"role": "xlabel", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "xlabel", "property": "FontSize", "value": 15},
    {"role": "xlabel", "property": "Color", "value": "#222222"},
    {"role": "ylabel", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "ylabel", "property": "FontSize", "value": 15},
    {"role": "ylabel", "property": "Color", "value": "#222222"},
    {"role": "ylabelRight", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "ylabelRight", "property": "FontSize", "value": 15},
    {"role": "legend", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "legend", "property": "FontSize", "value": 13},
    {"role": "legend", "property": "Color", "value": "#ffffff"},
    {"role": "legend", "property": "EdgeColor", "value": "#222222"},
    {"role": "colorbar", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "colorbar", "property": "FontSize", "value": 13},
    {"role": "colorbar", "property": "LineWidth", "value": 1.5},
    {"role": "colorbar", "property": "TickDirection", "value": "out"},

    {"role": "rate", "property": "LineWidth", "value": 2.5},
    {"role": "trace", "property": "LineWidth", "value": 2.5},
    {"role": "channelTrace", "property": "LineWidth", "value": 1.5},
    {"role": "curve", "property": "LineWidth", "value": 2.5},
    {"role": "curve", "property": "MarkerSize", "value": 8},
    {"role": "behaviorMean", "property": "LineWidth", "value": 2.5},
    {"role": "behaviorMean", "property": "MarkerSize", "value": 9},
    {"role": "stopLine", "property": "LineWidth", "value": 2},
    {"role": "zeroLine", "property": "Color", "value": "#444444"},
    {"role": "zeroLine", "property": "LineStyle", "value": "--"},
    {"role": "zeroLine", "property": "LineWidth", "value": 1.5},
    {"role": "chanceLine", "property": "Color", "value": "#777777"},
    {"role": "chanceLine", "property": "LineWidth", "value": 1.5},
    {"role": "stackBase", "property": "LineWidth", "value": 1},
    {"role": "modWindow", "property": "Color", "value": "#111111"},
    {"role": "modMarks", "property": "FontSize", "value": 13},
    {"role": "rasterTicks", "property": "Color", "value": "#111111"},
    {"role": "rasterTicks", "property": "LineWidth", "value": 1.25},
    {"role": "rasterStop", "property": "MarkerSize", "value": 12},
    {"role": "bar", "property": "EdgeColor", "value": "none"},
    {"role": "errorBar", "property": "LineWidth", "value": 1.5},
    {"role": "errorBar", "property": "CapSize", "value": 6},
    {"role": "box", "property": "LineWidth", "value": 1.5},
    {"role": "points", "property": "MarkerSize", "value": 14},
    {"role": "swarm", "property": "SizeData", "value": 40},
    {"role": "violin", "property": "LineWidth", "value": 1.5},
    {"role": "sites", "property": "MarkerEdgeColor", "value": "#222222"},
    {"role": "siteLabels", "property": "FontSize", "value": 12},
    {"role": "shankLabels", "property": "FontSize", "value": 14},
    {"role": "shankLabels", "property": "FontWeight", "value": "bold"},
    {"role": "unitDots", "property": "MarkerSize", "value": 16},
    {"role": "waveMean", "property": "LineWidth", "value": 2.5},
    {"role": "waveLabel", "property": "FontSize", "value": 11},
    {"role": "note", "property": "FontName", "value": "Segoe UI, Helvetica Neue, Arial"},
    {"role": "note", "property": "FontSize", "value": 12},
    {"role": "note", "property": "Color", "value": "#222222"}
  ],
  "kinds": {
    "heatmap": [
      {"role": "zeroLine", "property": "Color", "value": "#ffffff"}
    ]
  }
}
