    {"role": "zeroLine", "property": "LineWidth", "value": 0.5},
    {"role": "chanceLine", "property": "Color", "value": "#b0b0a8"},
    {"role": "chanceLine", "property": "LineStyle", "value": ":"},
    {"role": "chanceLine", "property": "LineWidth", "value": 0.75},
    {"role": "stackBase", "property": "Color", "value": "#e0e0d8"},
    {"role": "stopLine", "property": "LineWidth", "value": 0.75},
    {"role": "modWindow", "property": "FaceColor", "value": "#808080"},
    {"role": "modWindow", "property": "FaceAlpha", "value": 0.07},
    {"role": "modWindow", "property": "Color", "value": "#555555"},
    {"role": "modMarks", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "rasterTicks", "property": "Color", "value": "#333333"},
    {"role": "rasterTicks", "property": "LineWidth", "value": 0.5},
    {"role": "rasterStop", "property": "Color", "value": "#e15759"},
    {"role": "rasterStop", "property": "MarkerSize", "value": 5},
    {"role": "bar", "property": "EdgeColor", "value": "none"},
    {"role": "errorBar", "property": "Color", "value": "#555555"},
    {"role": "errorBar", "property": "LineWidth", "value": 0.75},
    {"role": "errorBar", "property": "CapSize", "value": 0},
    {"role": "box", "property": "LineWidth", "value": 0.75},
    {"role": "box", "property": "BoxFaceAlpha", "value": 0.15},
    {"role": "box", "property": "WhiskerLineColor", "value": "#808080"},
    {"role": "curve", "property": "MarkerSize", "value": 3.5},
    {"role": "curve", "property": "CapSize", "value": 0},
    {"role": "behaviorMean", "property": "CapSize", "value": 0},
    {"role": "swarm", "property": "MarkerFaceAlpha", "value": 0.55},
    {"role": "violin", "property": "FaceAlpha", "value": 0.25},
    {"role": "emptySites", "property": "Color", "value": "#cccccc"},
    {"role": "sites", "property": "MarkerEdgeColor", "value": "none"},
    {"role": "siteLabels", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "siteLabels", "property": "Color", "value": "#666666"},
    {"role": "shankLabels", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "shankLabels", "property": "FontAngle", "value": "italic"},
    {"role": "shankLabels", "property": "Color", "value": "#333333"},
    {"role": "unitDots", "property": "Color", "value": "#333333"},
    {"role": "waveBox", "property": "EdgeColor", "value": "#d9d9d0"},
    {"role": "waveMean", "property": "Color", "value": "#333333"},
    {"role": "waveLabel", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "waveLabel", "property": "Color", "value": "#666666"}
  ],
  "kinds": {
    "heatmap": [
      {"role": "zeroLine", "property": "Color", "value": "#8c8c84"},
      {"role": "zeroLine", "property": "LineStyle", "value": "--"}
    ],
    "corrmap": [
      {"role": "axes", "property": "Color", "value": "#ebebe4"}
    ]
  }
}
