{
  "schema": "ephys-plot-design",
  "version": 1,
  "name": "Tufte",
  "description": "Tufte's data-ink: an off-white page, serif type, no box or grid, quiet axes with short outward ticks, grey data and muted colour only where it tells groups apart.",
  "background": "#fffff8",
  "palette": ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#b07aa1", "#9c755f", "#bab0ac"],
  "single": "#555555",
  "sequential": ["#c6dbef", "#9ecae1", "#6baed6", "#3182bd", "#08519c"],
  "heat": ["#fffff8", "#deebf7", "#c6dbef", "#9ecae1", "#6baed6", "#3182bd", "#08519c"],
  "diverging": ["#76b7b2", "#c0ddd6", "#f0f0f0", "#f7c4c4", "#e15759"],
  "rules": [
    {"role": "plotTitle", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "plotTitle", "property": "FontWeight", "value": "normal"},
    {"role": "plotTitle", "property": "Color", "value": "#111111"},
    {"role": "plotSubtitle", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "plotSubtitle", "property": "FontAngle", "value": "italic"},
    {"role": "plotSubtitle", "property": "Color", "value": "#666666"},

    {"role": "axes", "property": "Color", "value": "none"},
    {"role": "axes", "property": "XColor", "value": "#808080"},
    {"role": "axes", "property": "YColor", "value": "#808080"},
    {"role": "axes", "property": "LineWidth", "value": 0.5},
    {"role": "axes", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "axes", "property": "TickDir", "value": "out"},
    {"role": "axes", "property": "TickLength", "value": [0.008, 0.02]},
    {"role": "axes", "property": "Box", "value": "off"},
    {"role": "axes", "property": "XGrid", "value": "off"},
    {"role": "axes", "property": "YGrid", "value": "off"},
    {"role": "rasterAxes", "property": "Color", "value": "none"},
    {"role": "rasterAxes", "property": "XColor", "value": "#808080"},
    {"role": "rasterAxes", "property": "YColor", "value": "#808080"},
    {"role": "rasterAxes", "property": "LineWidth", "value": 0.5},
    {"role": "rasterAxes", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "rasterAxes", "property": "TickDir", "value": "out"},
    {"role": "rasterAxes", "property": "TickLength", "value": [0.008, 0.02]},
    {"role": "rasterAxes", "property": "Box", "value": "off"},
    {"role": "rasterAxes", "property": "XGrid", "value": "off"},
    {"role": "rasterAxes", "property": "YGrid", "value": "off"},

    {"role": "tileTitle", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "tileTitle", "property": "FontWeight", "value": "normal"},
    {"role": "tileTitle", "property": "FontAngle", "value": "italic"},
    {"role": "tileTitle", "property": "Color", "value": "#333333"},
    {"role": "tileSubtitle", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "tileSubtitle", "property": "Color", "value": "#666666"},
    {"role": "xlabel", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "xlabel", "property": "Color", "value": "#666666"},
    {"role": "ylabel", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "ylabel", "property": "Color", "value": "#666666"},
    {"role": "ylabelRight", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "ylabelRight", "property": "Color", "value": "#666666"},
    {"role": "legend", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "legend", "property": "Color", "value": "#fffff8"},
    {"role": "legend", "property": "EdgeColor", "value": "#d9d9d0"},
    {"role": "legend", "property": "TextColor", "value": "#333333"},
    {"role": "colorbar", "property": "FontName", "value": "Palatino Linotype, Palatino, Book Antiqua, Georgia"},
    {"role": "colorbar", "property": "Box", "value": "off"},
    {"role": "colorbar", "property": "LineWidth", "value": 0.5},
    {"role": "colorbar", "property": "Color", "value": "#808080"},
    {"role": "colorbar", "property": "TickDirection", "value": "out"},

    {"role": "zeroLine", "property": "Color", "value": "#b0b0a8"},
